# Canvas LTI 1.3. Copy to .env.local for development, or set these on your host.
# Without LTI_CLIENT_ID the textbook still works; only the Canvas routes are disabled.

# Client ID of the Canvas LTI developer key (the long number in Admin > Developer Keys)
LTI_CLIENT_ID=

# Comma-separated deployment ids to accept. Leave empty to accept any deployment of the key.
LTI_DEPLOYMENT_IDS=

# RSA private key (PKCS#8 PEM) the tool signs with. Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out lti-private.pem
# Literal "\n" sequences are turned into newlines, so the key can be on one line.
LTI_PRIVATE_KEY=

# Long random string used to sign launch sessions (for example: openssl rand -base64 48)
LTI_SESSION_SECRET=

# Public URL of this site as Canvas reaches it. Needed behind a proxy; otherwise taken from the request.
LTI_TOOL_URL=

# Platform endpoints. The defaults are Instructure-hosted Canvas. For Canvas test/beta use
# https://canvas.test.instructure.com and the sso.test.canvaslms.com / sso.beta.canvaslms.com hosts.
# For self-hosted Canvas use your Canvas domain for all four.
LTI_PLATFORM_ISSUER=https://canvas.instructure.com
LTI_PLATFORM_AUTH_URL=https://sso.canvaslms.com/api/lti/authorize_redirect
LTI_PLATFORM_TOKEN_URL=https://sso.canvaslms.com/login/oauth2/token
LTI_PLATFORM_JWKS_URL=https://sso.canvaslms.com/api/lti/security/jwks
