  {
    "id": "custom-starts-with-1",
    "type": "dfa-design",
    "title": "DFA: Starts with '1'",
    "description": "Construct a DFA over {0, 1} that accepts strings starting with '1'.",
    "alphabet": ["0", "1"],
    "answerDFA": {
      "states": ["q0", "q1", "q2"],
      "alphabet": ["0", "1"],
      "initialState": "q0",
