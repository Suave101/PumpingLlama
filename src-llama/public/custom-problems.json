      "transitions": {
        "q0": { "1": "q1", "0": "q2" },
        "q1": { "0": "q1", "1": "q1" },
        "q2": { "0": "q2", "1": "q2" }
      }
    },
    "testCases": [
      { "input": "101", "expected": true },
      { "input": "1", "expected": true },
      { "input": "01", "expected": false },
      { "input": "", "expected": false }
    ]
  }
