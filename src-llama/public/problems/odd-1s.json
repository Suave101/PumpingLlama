{
  "id": "odd-ones",
  "type": "dfa-design",
  "title": "DFA: Odd Number of 1s",
  "description": "Construct a DFA over alphabet {0, 1} that accepts strings containing an odd number of \"1\"s.",
  "alphabet": ["0", "1"],
  "answerDFA": {
    "states": ["q0", "q1"],
    "alphabet": ["0", "1"],
    "initialState": "q0",
    "acceptStates": ["q1"],
    "transitions": {
      "q0": { "0": "q0", "1": "q1" },
      "q1": { "0": "q1", "1": "q0" }
    }
  },
  "testCases": [
    { "input": "1", "expected": true },
    { "input": "010", "expected": true },
    { "input": "111", "expected": true },
    { "input": "11", "expected": false },
    { "input": "000", "expected": false },
    { "input": "", "expected": false }
  ]
}