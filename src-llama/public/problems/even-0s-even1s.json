{
  "id": "even-0s-even-1s",
  "type": "dfa-design",
  "title": "DFA: Even Number of 0s and Even Number of 1s",
  "description": "Construct a DFA over alphabet {0, 1} that accepts strings containing both an even number of \"0\"s and an even number of \"1\"s.",
  "alphabet": ["0", "1"],
  "answerDFA": {
    "states": ["q0", "q1", "q2", "q3"],
    "alphabet": ["0", "1"],
    "initialState": "q0",
    "acceptStates": ["q0"],
    "transitions": {
      "q0": { "0": "q1", "1": "q2" },
      "q1": { "0": "q0", "1": "q3" },
      "q2": { "0": "q3", "1": "q0" },
      "q3": { "0": "q2", "1": "q1" }
    }
  },
  "testCases": [
    { "input": "", "expected": true },
    { "input": "0011", "expected": true },
    { "input": "0101", "expected": true },
    { "input": "0", "expected": false },
    { "input": "1", "expected": false },
    { "input": "001", "expected": false }
  ]
}